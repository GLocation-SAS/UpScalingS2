<!DOCTYPE html>
<html lang="es">

<head>
  <title>Visor MapLibre</title>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/public/img/Favicon.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Visor de mapa con MapLibre GL JS" />
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.18.0/dist/maplibre-gl.css" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/modules/map/views/map.css" />
  <link rel="stylesheet" href="/css/output.css">
  <!-- API Key for new Google Places API -->
  <script>
    window.GOOGLE_PLACES_API_KEY = "<%= API_KEY %>";
  </script>
</head>

<body>
  <div id="progress-overlay" class="progress-overlay hidden">
    <div class="progress-card">
      <h2>Procesando tu imagen...</h2>
      <p id="progress-text">Este proceso puede tardar varios minutos. Por favor, no cierres esta ventana.</p>
      <div class="progress-track">
        <div id="progress-bar" class="progress-bar" style="width: 0%;"></div>
      </div>
      <p id="progress-counter" class="progress-counter">0 / 0</p>
    </div>
  </div>

  <main class="layout">
    <header class="hero relative z-10 p-6 flex justify-between items-center w-full mx-auto">
      <div class="flex items-center gap-2 group cursor-pointer relative">
        <img src="/public/img/Logo_Horizontal.png" alt="UpScalingS2" class="w-36 h-12 dark:hidden" />
        <img src="/public/img/Logo_Horizonal_Blanco.png" alt="UpScalingS2" class="w-36 h-12 hidden dark:block" />
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter inline-block">
        <span class="text-results dark:text-white">Captura de imagen Sentinel-2</span><span
          class="text-primary dark:text-white"> | </span>
        <span class="text-primary dark:text-white">UpScaling</span><span class="logo-s2-color">S2</span>
      </h1>
      <button class="p-2 flex rounded-full text-primary px-5  bg-secondary/30 dark:text-white transition-colors"
        onclick="document.documentElement.classList.toggle('dark')">
        <span class="material-icons-round">dark_mode</span>
      </button>
    </header>
    <section class="map-shell">
      <aside class="sidebar">
        <div class="sidebar-header">
          <h3>Herramientas</h3>
        </div>

        <div class="sidebar-section">
          <label for="date-picker">Fecha Sentinel 2</label>
          <input type="date" id="date-picker" class="form-control" />
        </div>

        <div class="sidebar-section">
          <label for="upscaling-model-select">Modelo de mejora</label>
          <select id="upscaling-model-select" name="upscalingModel" class="form-control">
            <option value="upscaling" selected>UpScaling</option>
            <option value="building_footprint">Building footprint</option>
            <option value="ways" disabled>Ways</option>
            <option value="forest" disabled>Forest</option>
            <option value="trees" disabled>Trees</option>
          </select>
        </div>

        <div class="sidebar-section">
          <h4>Herramienta de selección</h4>
          <div class="tool-buttons">
            <button id="draw-rectangle" class="tool-btn" title="Dibujar rectángulo">
              <svg width="20" height="20" viewBox="0 0 20 20">
                <rect x="3" y="4" width="14" height="12" stroke="currentColor" stroke-width="2" fill="none" />
              </svg>
              Rectángulo
            </button>
            <button id="delete-all" class="tool-btn danger" title="Limpiar">
              <svg width="20" height="20" viewBox="0 0 20 20">
                <path d="M6 2h8v2H6V2zm-2 4h12v12H4V6zm3 2v8h2V8H7zm4 0v8h2V8h-2z" fill="currentColor" />
              </svg>
              Limpiar
            </button>
          </div>
        </div>

        <div class="sidebar-section">
          <label>Geometría capturada</label>
          <textarea id="geometry-output" class="geometry-display" rows="6" readonly
            placeholder="La geometría aparecerá aquí..."></textarea>
        </div>

        <div class="sidebar-section">
          <button id="capture-btn" class="capture-btn">
            <svg width="18" height="18" viewBox="0 0 20 20">
              <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11h-2V9h2v4zm0-5h-2V6h2v2z" fill="currentColor" />
            </svg>
            Capturar y procesar
          </button>
        </div>
      </aside>

      <div style="position: relative; flex: 1;">
        <div class="google-search-box">
          <input id="google-places-search" type="search" placeholder="Busca dirección o lugar" autocomplete="off" />
          <div id="places-suggestions" class="places-suggestions"></div>
        </div>

        <div id="<%= mapConfig.containerId %>" class="map" data-tile-url="<%= mapConfig.tileUrl %>"
          data-center='<%- JSON.stringify(mapConfig.center) %>' data-zoom="<%= mapConfig.zoom %>"
          data-logo="<%= mapConfig.maplibreLogo %>">
        </div>
      </div>
    </section>
  </main>

  <script src="https://unpkg.com/maplibre-gl@5.18.0/dist/maplibre-gl.js"></script>
  <script src="/assets/modules/map/views/map.js"></script>
  <script type="module" src="../js/main.js"></script>
</body>

</html>